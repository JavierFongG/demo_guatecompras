# Variables de la API en producción. Copia a .env (chmod 600). Nunca lo subas al repositorio.

# --- Modo y datos ---
GC_MODE=api
GC_ARTIFACTS_URL=https://index.example.gt/index
GC_ARTIFACTS_POLL=1800
GC_THREADS=2

# --- Acceso ---
GC_CORS_ORIGINS=https://app.example.gt
GC_SUPABASE_URL=https://<proyecto>.supabase.co
GC_AUTH_REQUIRED=1
# Solo para tareas automáticas (el pipeline avisa a /api/admin/sync). Genera con: openssl rand -hex 32
GC_ADMIN_TOKEN=
GC_RATE_LIMIT=120

# --- Observabilidad ---
SENTRY_DSN=
GC_ENV=production

# --- Cloudflare Tunnel (Zero Trust → Networks → Tunnels → tu túnel → token) ---
TUNNEL_TOKEN=

# --- Imagen (opcional; por defecto ghcr.io/javierfongg/guatecompras-api:latest) ---
# API_IMAGE=ghcr.io/<usuario>/guatecompras-api:latest
