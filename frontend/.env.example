# Variables del frontend (se leen al compilar: npm run build). En Cloudflare Pages van en
# Settings → Environment variables. Copia este archivo a .env para desarrollo local.

# URL pública de la API. Vacía = mismo origen (proxy de Vite en desarrollo).
VITE_API_BASE=https://api.example.gt

# Login con Supabase (Project Settings → API). La "anon key" es pública por diseño.
# Vacías = sin login (desarrollo local).
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opcionales
VITE_SENTRY_DSN=
VITE_FEEDBACK_URL=
VITE_CONTACT_EMAIL=
